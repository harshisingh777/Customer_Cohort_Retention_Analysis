# Copy to .env for local development. Every value here is a placeholder.
# Nothing environment-specific is hardcoded in the services: they all read these.

APP_ENV=local

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=retention
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Per-role passwords. infra/db/init creates the roles with these.
MIGRATOR_PASSWORD=change-me-migrator
PIPELINE_PASSWORD=change-me-pipeline
API_RO_PASSWORD=change-me-api-ro
API_OPS_PASSWORD=change-me-api-ops
WEB_AUTH_PASSWORD=change-me-web-auth

# Connection strings. Host "db" is the compose service; use localhost:5433 outside compose.
MIGRATOR_DATABASE_URL=postgresql://migrator:change-me-migrator@db:5432/retention
PIPELINE_DATABASE_URL=postgresql://pipeline_rw:change-me-pipeline@db:5432/retention
API_DATABASE_URL=postgresql://api_ro:change-me-api-ro@db:5432/retention
API_OPS_DATABASE_URL=postgresql://api_ops:change-me-api-ops@db:5432/retention
WEB_DATABASE_URL=postgresql://web_auth:change-me-web-auth@db:5432/retention

# --- Secrets ------------------------------------------------------------
# HMAC key for customer emails. Rotating it re-keys every customer: see docs/runbook.md.
PII_KEY=change-me-32-random-bytes-hex
# Shared only between web (signs) and api/worker (verify / mint print tokens).
API_JWT_SECRET=change-me-long-random-string
# Signs export download links when exports are stored in Postgres.
EXPORT_SIGNING_KEY=change-me-another-random-string
# Auth.js
AUTH_SECRET=change-me-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
# Magic-link email. Leave EMAIL_SERVER empty in local dev: links are printed to the web log.
EMAIL_SERVER=
EMAIL_FROM="Retention <no-reply@example.com>"
# Local and CI only: enables a passwordless sign-in for allowlisted emails. Never set in production.
AUTH_DEV_LOGIN=1

BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Service wiring -----------------------------------------------------
API_BASE_URL=http://api:8000
# The API as the browser reaches it.
PUBLIC_API_URL=http://localhost:8000
WEB_BASE_URL=http://web:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Exports ------------------------------------------------------------
# When S3_BUCKET is empty, export files are stored in Postgres (ops.export_files).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Observability ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
PIPELINE_WEBHOOK_URL=
GIT_SHA=local

# --- Shopify / WooCommerce (worker only) --------------------------------
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
