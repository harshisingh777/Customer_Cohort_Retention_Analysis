    "@radix-ui/react-tooltip": "1.4.1",
    "@sentry/nextjs": "11.7.0",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.19",
    "@visx/group": "4.0.0",
    "@visx/shape": "4.0.0",
    "d3-scale": "4.0.2",
    "jose": "6.2.12",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "nuqs": "2.10.2",
    "pg": "8.23.1",
    "react": "19.3.1",
